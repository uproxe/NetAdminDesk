; Браузер NetLoom, который установщик NetAdmin Desk предлагает поставить (необязательно).
; Файл скачивается с GitHub во время установки и проверяется по SHA-256 ниже.
; Обновить версию: node scripts/update-netloom.mjs <версия>  (скачает файл и пересчитает сумму и размер).
!define NETLOOM_VERSION "1.0.3"
!define NETLOOM_URL "https://github.com/uproxe/NetLoom/releases/download/v1.0.3/NetLoom-1.0.3-windows-x64-setup.exe"
!define NETLOOM_SHA256 "024ba6b065ace478b2f6955981c8a564766847c717749af33b1956a008b488f7"
!define NETLOOM_BYTES "129192569"
!define NETLOOM_SIZE_MB "123"
